# Environment variables - LOCAL SETUP (No Docker)
NODE_ENV=development

# MongoDB Configuration - LOCAL
# Install MongoDB locally: https://www.mongodb.com/try/download/community
MONGO_URI=mongodb://localhost:27017/inventory
MONGO_DB_NAME=inventory

# Redis Configuration - LOCAL
# Install Redis locally: https://redis.io/download
# Windows: https://github.com/microsoftarchive/redis/releases
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka Configuration - LOCAL
# Install Kafka locally: https://kafka.apache.org/downloads
# Or use Confluent Platform: https://www.confluent.io/download/
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=mini-inventory

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# API Gateway
GATEWAY_PORT=3000

# Service Ports
AUTH_SERVICE_PORT=4001
INVENTORY_SERVICE_PORT=4002
ORDER_SERVICE_PORT=4003
NOTIFICATION_SERVICE_PORT=4004

# Frontend
VITE_API_GATEWAY_URL=http://localhost:3000
VITE_WS_URL=http://localhost:4004

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
